{
  "name": "@globalmpc/jev-router",
  "version": "0.3.0",
  "description": "Runs coding CLIs and routes each turn to the cheapest sufficient model using TypeSafe Jev",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globalmpc/jev-router-effort.git"
  },
  "homepage": "https://github.com/globalmpc/jev-router-effort#readme",
  "bugs": "https://github.com/globalmpc/jev-router-effort/issues",
  "bin": {
    "jev": "bin/jev.mjs",
    "jev-a": "bin/jev-anti.mjs",
    "jev-agy": "bin/jev-anti.mjs",
    "jev-anti": "bin/jev-anti.mjs",
    "jev-antigravity": "bin/jev-anti.mjs",
    "jev-claude": "bin/jev-claude.mjs",
    "jev-codex": "bin/jev-codex.mjs",
    "jev-glm": "bin/jev-glm.mjs",
    "jev-explain": "bin/jev-explain.mjs",
    "jev-maintain": "bin/jev-maintain.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "files": [
